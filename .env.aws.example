# Copiar a .env.aws en la EC2 de apps y completar. NO versionar el .env.aws.

# ---- Azure AD (App Registration "AgroTrack") ----
AZURE_TENANT_ID=
AZURE_API_CLIENT_ID=
AZURE_ISSUER_URI=https://login.microsoftonline.com/${AZURE_TENANT_ID}/v2.0

# ---- Hosts: IP PRIVADA de cada EC2 ----
POSTGRES_HOST=10.0.0.10
RABBITMQ_HOST=10.0.0.20
KAFKA_BOOTSTRAP=10.0.0.30:9092,10.0.0.30:9093,10.0.0.30:9094
KAFKA_REPLICAS=3

# ---- Credenciales ----
POSTGRES_DELIVERIES_PASSWORD=agro_deliveries
POSTGRES_CATALOG_PASSWORD=agro_catalog
POSTGRES_AUDIT_PASSWORD=agro_audit
POSTGRES_REPORT_PASSWORD=agro_report
RABBITMQ_USER=agrotrack
RABBITMQ_PASSWORD=CambiaEsto123

# ---- Frontend (origen permitido en CORS) ----
CORS_ORIGENES=http://<IP_PUBLICA_EC2_APPS>

# ---- SMTP opcional (sin esto, notify escribe los emails en el log) ----
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
