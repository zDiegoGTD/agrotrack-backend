# ---- PostgreSQL (superusuario de la instancia; los servicios usan su propio rol) ----
POSTGRES_USER=agrotrack
POSTGRES_PASSWORD=CambiaEsto123

# ---- RabbitMQ ----
RABBITMQ_USER=agrotrack
RABBITMQ_PASSWORD=CambiaEsto123
RABBITMQ_ERLANG_COOKIE=cookie-compartida-del-cluster

# ---- Azure AD / Entra ID (solo perfil aws) ----
AZURE_TENANT_ID=
AZURE_API_CLIENT_ID=
AZURE_ISSUER_URI=https://login.microsoftonline.com/${AZURE_TENANT_ID}/v2.0

# ---- Hosts (en local todo es localhost; en AWS son las IP privadas de cada EC2) ----
POSTGRES_HOST=postgres
RABBITMQ_HOST=rabbitmq
KAFKA_BOOTSTRAP=kafka:9092
